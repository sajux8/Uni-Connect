# Copy to .env.local and fill in. .env.local is git-ignored. NEVER commit real keys.

# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # the browser-safe "publishable" (a.k.a. anon) key
SUPABASE_SERVICE_ROLE_KEY=              # SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100
CRON_SECRET=                            # long random string; protects /api/cron/*. Same value in Vercel; then run npm run setup:cron

# --- AI (M8) -----------------------------------------------------------------
# Only the key is needed: create one at aistudio.google.com (free). Never NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_PROVIDER=google
GROQ_API_KEY=                           # optional: answers when Gemini is unavailable
# Optional overrides (the defaults were tested at M8; see src/lib/ai/config.ts).
AI_CHAT_MODEL=                          # default gemini-3.5-flash
AI_CHAT_FALLBACK_MODEL=                 # default gemini-3.5-flash-lite
AI_EMBED_MODEL=                         # default gemini-embedding-001 (changing it means re-indexing)
AI_DAILY_ASK_LIMIT=20
AI_DAILY_SUMMARY_LIMIT=10
AI_DEBUG=                               # 1 = log retrieval timings and similarity scores

# --- Email (M3) --------------------------------------------------------------
# Gmail: turn on 2-Step Verification, create an App password (Google Account -> Security),
# then SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the gmail address>, SMTP_PASS=<app password>.
# Without these, emails wait in the email_outbox table and nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=                             # optional, e.g. "UniConnect <you@gmail.com>"; defaults to SMTP_USER
